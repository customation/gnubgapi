# Let each platform use its native line ending (LF in repo, native in worktree)
* text=auto

# Shell scripts MUST stay LF even on Windows
*.sh       text eol=lf
*.bash     text eol=lf

# Windows-native scripts MUST stay CRLF even on Linux
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binaries — never touch
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.7z       binary
*.dll      binary
*.exe      binary
*.so       binary
*.dylib    binary
*.pdb      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.snk      binary
