<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>GammonBase.GnuBgApi</PackageId>
    <Version>0.1.0</Version>
    <Authors>Sven Thorsen</Authors>
    <Description>GnuBG native API bindings for GammonBase.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/customation/gnubgapi</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>backgammon;gnubg;ffi</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\runtimes\**\*" Pack="true" PackagePath="runtimes\" />
    <!-- Data files packed under content/ for the .targets to reference -->
    <None Include="..\..\data\*" Pack="true" PackagePath="content\gnubg-data\" />
    <!-- MSBuild targets that copy data files to consumer output -->
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Copy native binaries (+ runtime deps) to output for project-reference and local dev -->
  <ItemGroup>
    <None Include="..\..\runtimes\win-x64\native\*.dll"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase=""
          Visible="false" />
    <None Include="..\..\runtimes\linux-x64\native\*.so"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase=""
          Visible="false" />
    <Content Include="..\..\data\*"
             CopyToOutputDirectory="PreserveNewest"
             LinkBase="gnubg-data"
             Visible="false" />
  </ItemGroup>
</Project>
